# Copy to .env for local development. In staging/production these are injected by the platform's secrets manager.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Proxies allowed to set X-Forwarded-For: a hop count (1 = one proxy in front) or the proxy's CIDR. Never "true" in production.
TRUST_PROXY=false
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173

DATABASE_URL=postgres://storekeeper:storekeeper@localhost:5432/storekeeper
DB_POOL_MAX=10
# Optional read replica. Dashboard, analytics and reports read from it so heavy reads never compete with ledger writes.
# Leave unset in development: those reads simply use DATABASE_URL.
# DATABASE_READ_URL=postgres://storekeeper:storekeeper@replica-host:5432/storekeeper
# DB_READ_POOL_MAX=10
REDIS_URL=redis://localhost:6379

SESSION_TTL_SECONDS=43200
IDEMPOTENCY_KEY_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# Object storage (docker-compose provides MinIO). PRIVATE bucket; files are served via signed URLs only.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=storekeeper-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email: nodemailer -> Mailgun SMTP. For local dev leave MAIL_ENABLED=false (outbox rows are marked sent, not delivered).
MAIL_ENABLED=false
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=postmaster@mg.your-domain.com
MAIL_PASS=
MAIL_FROM=StoreKeeper <no-reply@mg.your-domain.com>

# queue = BullMQ worker process (production). inline = run jobs inside the API process (tests / quick local dev).
JOBS_MODE=queue

# Circuit breakers (defaults for every dependency breaker)
BREAKER_FAILURE_THRESHOLD=5
BREAKER_WINDOW_MS=30000
BREAKER_RESET_TIMEOUT_MS=20000
BREAKER_CALL_TIMEOUT_MS=8000

# Set to enable GET /metrics (Bearer). Leave empty to disable the endpoint.
METRICS_TOKEN=

# CSV import: files are streamed into a staging table, so memory stays flat. These are the limits the web page also states.
IMPORT_MAX_MB=100
IMPORT_MAX_ROWS=200000
IMPORT_CHUNK_ROWS=500
